{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "0.2.4",
  "identifier": "io.loom.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Loom",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://127.0.0.1:3000; img-src 'self' data: blob: http://127.0.0.1:8000; media-src 'self' http://127.0.0.1:8000; object-src 'self' http://127.0.0.1:8000; frame-src 'self' http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QkZERjVDODNFOTk0NUUKUldSZWxPbURYTisvNVcxUGN0NHZEWE1yZERNTmI1QWJORzlIaEhFYTF2bTMvMHFNQjhETGk4RG4K",
      "endpoints": [
        "https://github.com/jrwinget/loom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Evidence operating system for legal observers",
    "longDescription": "Loom combines video, photos, and statements into defensible event timelines for civil-liberties legal observers.",
    "externalBin": ["../../backend/dist/loom-backend"],
    "resources": ["binaries/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
