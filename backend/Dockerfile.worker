# temporal worker — shares the same codebase but runs the worker
FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/

RUN uv sync --frozen --no-dev

FROM python:3.12-slim

# apt-get upgrade picks up debian os-level security patches that lag the
# base-image rebuild cadence (mirrors the apk upgrade in frontend/Dockerfile).
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 loom \
    && useradd --uid 1000 --gid loom --shell /bin/bash loom

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER loom

CMD ["python", "-m", "loom.workers.worker"]
